{
  "name": "id",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Indy-Center/identity.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply id_db --local",
    "client": "node --experimental-strip-types --no-warnings scripts/manage.ts client",
    "role": "node --experimental-strip-types --no-warnings scripts/manage.ts role"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.6",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15",
    "hono-openapi": "^1.3.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.1",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@standard-schema/spec": "^1.1.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.4.0"
  }
}
