{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "noUncheckedIndexedAccess": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "vitest.config.ts",
    "drizzle.config.ts",
    "scripts/manage.ts",
    "node_modules"
  ]
}
